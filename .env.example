# URL pública, sem barra ao fim (usada em canonical e Open Graph)
NEXT_PUBLIC_SITE_URL=https://exemplo.com.br

# Configure ao menos um canal. Nunca coloque segredos em NEXT_PUBLIC_*.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_CONTACT_EMAIL=contato@exemplo.com.br

# Mantém o starter neutro até uma ferramenta e consentimento serem definidos.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
