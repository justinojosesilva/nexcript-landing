# URL pública, sem barra ao fim (usada em canonical e Open Graph)
NEXT_PUBLIC_SITE_URL=https://exemplo.com.br

# Configure ao menos um canal. Nunca coloque segredos em NEXT_PUBLIC_*.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_CONTACT_EMAIL=contato@exemplo.com.br

# Mantém o starter neutro até uma ferramenta e consentimento serem definidos.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Captação de leads — banco Turso (SQLite). Sem URL em dev, usa .data/leads.db.
TURSO_DATABASE_URL=libsql://nexcript-leads-seu-usuario.turso.io
TURSO_AUTH_TOKEN=

# E-mails via Resend. Sem chave, os leads são salvos e nenhum e-mail sai.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=voce@exemplo.com.br
# Remetente. onboarding@resend.dev só entrega para o e-mail da conta Resend.
LEAD_FROM_EMAIL=Nexcript <onboarding@resend.dev>
# Confirmação ao visitante: ligar só com domínio verificado no Resend.
LEAD_CONFIRMATION_ENABLED=false

# Área interna /interno/leads (usuário e senha do navegador).
INTERNAL_USER=
INTERNAL_PASSWORD=
